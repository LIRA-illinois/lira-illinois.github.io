---
import PageLayout from "../layouts/PageLayout.astro";
import Publication from "../components/Publication.astro";
import pubs from "../assets/pubs.json";

type PublicationEntry = (typeof pubs)[number];

const getDateParts = (pub: PublicationEntry): number[] =>
  pub.issued?.["date-parts"]?.[0] ?? [];

const sortedPubs = [...pubs].sort((a, b) => {
  const [ay, am = 1, ad = 1] = getDateParts(a);
  const [by, bm = 1, bd = 1] = getDateParts(b);
  return by - ay || bm - am || bd - ad;
});

const isArxivWithoutContainerTitle = (pub: PublicationEntry): boolean => {
  const hasContainerTitle = Boolean(pub["container-title"]);
  const doi = (pub["DOI"] ?? "").toLowerCase();
  return !hasContainerTitle && doi.includes("arxiv");
};

const arxivPubs = sortedPubs.filter(isArxivWithoutContainerTitle);
const nonArxivPubs = sortedPubs.filter((pub) => !isArxivWithoutContainerTitle(pub));

const pubsByYear = nonArxivPubs.reduce<Record<string, PublicationEntry[]>>((acc, pub) => {
  const [year] = getDateParts(pub);
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(pub);
  return acc;
}, {});

const years = Object.keys(pubsByYear)
  .sort((a, b) => Number(b) - Number(a));
---

<PageLayout>
  <h2>Publications</h2>
  <p>
    Our publications are also available on Huy's
    <a href="https://scholar.google.com/citations?hl=en&user=TgaPukcAAAAJ&view_op=list_works&sortby=pubdate"> Google Scholar page</a>.
  </p>
  <div class="pubs-container">
    {arxivPubs.length > 0 && (
      <div class="pub-year">
        <h4>Preprints</h4>
        <div class="year-container">
          {arxivPubs.map((pub) => (
            <Publication pub={pub} />
          ))}
        </div>
      </div>
    )}
    {years.map((year) => (
      <div class="pub-year">
        <h4>{year}</h4>
        <div class="year-container">
          {pubsByYear[year].map((pub) => (
            <Publication pub={pub} />
          ))}
        </div>
      </div>
    ))}
  </div>
</PageLayout>
<style>
  .pubs-container {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    margin-top: 4rem;
  }
  .year-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 2rem;
  }
</style>
